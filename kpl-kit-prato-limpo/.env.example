# ===== PushInPay (Pix) =====
# Token da API da PushInPay. Painel PushInPay > API/Integrações.
PUSHINPAY_TOKEN=

# Opcional. Só mude se a PushInPay indicar outra base (ex.: sandbox).
PUSHINPAY_API_URL=https://api.pushinpay.com.br

# URL pública do site, usada para montar o webhook_url enviado à PushInPay.
# Ex.: https://kit-prato-limpo.vercel.app  (sem barra no final)
PUBLIC_BASE_URL=

# Opcional. Token que a PushInPay devolve no header x-pushinpay-token em cada
# webhook, pra validar que a chamada é mesmo deles. Cadastre o mesmo valor no
# painel PushInPay > Webhooks.
PUSHINPAY_WEBHOOK_TOKEN=

# ===== Entrega por e-mail (Resend) =====
# Chave da API do Resend (painel Resend > API Keys).
RESEND_API_KEY=

# Remetente das entregas, ex.: entrega@nutriplan.email (domínio já verificado no Resend).
DELIVERY_FROM_EMAIL=

# Link direto do PDF do kit hospedado (ex.: assets/kit-prato-limpo-<hash>.pdf).
DELIVERY_KIT_URL=

# Opcional. Se preenchido, todo pagamento aprovado via webhook (rede de segurança)
# manda um aviso pra esse e-mail, pra você conferir/entregar manualmente se precisar.
ADMIN_ALERT_EMAIL=
